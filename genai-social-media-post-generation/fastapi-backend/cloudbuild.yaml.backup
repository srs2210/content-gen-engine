# cloudbuild.yaml
steps:
  # 1. Build Image using Docker builder
  - name: 'gcr.io/cloud-builders/docker'
    args: [
      'build',
      '-t', '${_AR_REGION}-docker.pkg.dev/${PROJECT_ID}/${_AR_REPO_NAME}/${_APP_NAME}:latest', # Corrected image path format & Added comma
      '.' # Build context
    ]
    id: 'Build'

  # 2. Push Image with 'latest' tag using Docker builder
  # Note: Consider pushing with SHORT_SHA for better version tracking in production
  - name: 'gcr.io/cloud-builders/docker'
    args: ['push', '${_AR_REGION}-docker.pkg.dev/${PROJECT_ID}/${_AR_REPO_NAME}/${_APP_NAME}:latest'] # Corrected image path format
    id: 'Push Latest'
    waitFor: ['Build'] # Ensure build is done before pushing

  # 3. Setup Kubeconfig for the build step using gcloud builder
  - name: 'gcr.io/cloud-builders/gcloud' # Provides gcloud & kubectl
    args:
    - '-c'
    - |
      gcloud container clusters get-credentials "${_GKE_CLUSTER_NAME}" \
        --zone "${_GKE_CLUSTER_ZONE}" \
        --project "${PROJECT_ID}"
    entrypoint: 'bash' # Use bash to execute the multi-line command
    id: 'Setup Kubeconfig'
    # No explicit waitFor needed here if subsequent steps wait for it

  # 4. Prepare Manifests - Substitute Image Placeholder using gcloud builder (includes sed)
  # Using placeholder __IMAGE_PLACEHOLDER__ in deployment.yaml
  - name: 'gcr.io/cloud-builders/gcloud' # Provides sed
    entrypoint: 'sed'
    args: [
      '-i', # In-place edit
      # Corrected sed command: s|find|replace|g using | as delimiter
      's|__IMAGE_PLACEHOLDER__|${_AR_REGION}-docker.pkg.dev/${PROJECT_ID}/${_AR_REPO_NAME}/${_APP_NAME}:latest|g',
      '${_K8S_MANIFEST_DIR}/deployment.yaml' # Assumes deployment.yaml is in the k8s dir relative to root
    ]
    id: 'Substitute Image Tag'
    waitFor: ['Setup Kubeconfig'] # Ensure kubeconfig setup isn't strictly needed, but good practice

  # 5. Apply All Manifests using gcloud builder (includes kubectl)
  # Ensures Namespace, ConfigMap, Secrets, Service, HPA are up-to-date before Deployment
  - name: 'gcr.io/cloud-builders/gcloud' # Provides kubectl configured by gcloud steps
    entrypoint: 'kubectl'
    args: [
      'apply',
      '-f', '${_K8S_MANIFEST_DIR}/', # Apply all files in the directory
      '--namespace=${_K8S_NAMESPACE}'
      # '--validate=false' # Optionally disable validation if needed
    ]
    id: 'Apply Manifests'
    env:
      - 'CLOUDSDK_COMPUTE_ZONE=${_GKE_CLUSTER_ZONE}'
      - 'CLOUDSDK_CONTAINER_CLUSTER=${_GKE_CLUSTER_NAME}'
    waitFor: ['Substitute Image Tag', 'Push Latest'] # Corrected: Wait for image push & substitution

  # 6. Verify Deployment Rollout using gcloud builder (includes kubectl)
  - name: 'gcr.io/cloud-builders/gcloud' # Provides kubectl configured by gcloud steps
    entrypoint: 'kubectl'
    args: [
      'rollout', 'status',
      'deployment/${_K8S_DEPLOYMENT_NAME}',
      '--namespace=${_K8S_NAMESPACE}',
      '--timeout=10m' # Set a reasonable timeout
    ]
    id: 'Verify Rollout'
    env:
      - 'CLOUDSDK_COMPUTE_ZONE=${_GKE_CLUSTER_ZONE}'
      - 'CLOUDSDK_CONTAINER_CLUSTER=${_GKE_CLUSTER_NAME}'
    waitFor: ['Apply Manifests'] # Wait for apply to finish

# Define substitutions with default values (can be overridden by trigger/script)
substitutions:
  _AR_REGION: 'asia-southeast1'
  _AR_REPO_NAME: 'pru-marketing-gen' # Your Artifact Registry repo name
  _APP_NAME: 'pru-market-gen'        # Your application/image name
  _GKE_CLUSTER_NAME: 'pru-marketing-cluster'
  _GKE_CLUSTER_ZONE: 'asia-southeast1-c'
  _K8S_NAMESPACE: 'pru-market-gen-ns'
  # NOTE: Script passes '../k8s', this default 'k8s' will be overridden if script provides it.
  # Ensure the path is correct relative to the root of your build context.
  _K8S_MANIFEST_DIR: 'k8s'
  _K8S_DEPLOYMENT_NAME: 'pru-market-gen-deployment'
  # PROJECT_ID is automatically available

# Specify the image built and pushed by this pipeline (using corrected format)
images:
- '${_AR_REGION}-docker.pkg.dev/${PROJECT_ID}/${_AR_REPO_NAME}/${_APP_NAME}:latest'

options:
  logging: CLOUD_LOGGING_ONLY # Use Cloud Logging for build logs
  machineType: 'E2_HIGHCPU_8' # Optional: Specify machine type
